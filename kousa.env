# Required by kousa/config/releases.exs
DATABASE_URL=postgres://postgres:postgres@postgres/postgres
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Public URLs used for OAuth callback + redirects
WEB_URL=http://localhost:3000
API_URL=http://localhost:4001
PORT=4001

# Auth and signing secrets (replace with long random values)
SECRET_KEY_BASE=replace-with-long-random-secret
ACCESS_TOKEN_SECRET=replace-with-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-long-random-secret
BEN_GITHUB_ID=replace-with-your-github-id

# OAuth providers (required at boot in this codebase)
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
TWITTER_API_KEY=replace-me
TWITTER_SECRET_KEY=replace-me
TWITTER_BEARER_TOKEN=replace-me
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Required by current production config; use a real DSN in production
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional
IS_STAGING=true

