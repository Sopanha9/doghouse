# RabbitMQ connection shared with kousa
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Mediasoup listen config
# For local testing, 127.0.0.1 works.
# For internet users, set A_IP to your public server IP or DNS-resolved IP.
WEBRTC_LISTEN_IP=127.0.0.1
A_IP=

# Optional
QUEUE_ID=
SENTRY_DNS=
NODE_ENV=production
